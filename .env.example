# ============ API Keys（按供应商集中管理）============
# 根 .env 是三个项目密钥的唯一事实源，不入版本控制。
# 空值表示未配置，子项目使用自身降级默认运行，不阻塞启动。

# deepseek：推理/文本模型（QED-Engine 后端、解析文本模型，预留）
DEEPSEEK_API_KEY=

# qwen：阿里百炼，OCR/视觉模型
# 映射：Axiom-Flow 读 AXIOM_API_KEY，QED-Tracker 读 DASHSCOPE_API_KEY
QWEN_API_KEY=

# glm：智谱（备选/未来模型，预留）
GLM_API_KEY=

# ============ 模型选择 ============
# OCR/视觉模型，统一指定；映射：Axiom-Flow 读 AXIOM_VISION_MODEL
QED_OCR_MODEL=qwen-vl-ocr
