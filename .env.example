# QED-Engine 根 .env 模板（复制为 .env；空值 = 未配置，服务降级运行）

# ============ 一、全局配置 ============
QED_API_SELECT=api                 # 默认模型来源：api | local（qed-engine 仅子项目）
QED_LLM_GATEWAY_URL=http://127.0.0.1:8900
QED_LLM_TIMEOUT=300
QED_DATA_ROOT=D:\coding\QED-Engine\dataset
QED_PROXY=http://127.0.0.1:7890

# ============ 二、API 调用配置 ============
QED_API_PROVIDER=qwen              # 厂商：qwen | deepseek | glm
API_KEY=
QED_MODEL=qwen-plus                # 文字槽位身份（local 由控制台选择覆盖）
QED_OCR_MODEL=qwen-vl-plus         # 图像槽位身份
QED_EMBEDDING_MODEL=text-embedding-v4  # 向量槽位身份

# ============ 三、本地模型配置 ============
QED_LOCAL_RUNTIME=lmstudio         # 本地渠道：lmstudio | llamacpp | docker
QED_MODEL_URL=http://127.0.0.1:5001/v1    # 文字模型地址（5001）
QED_OCR_MODEL_URL=http://127.0.0.1:5002   # 图像模型地址（5002）
QED_LMSTUDIO_TOKEN=                # 仅 LM Studio 需鉴权；其余渠道留空
QED_RESOURCE_GUARD=true            # 单活仲裁：本地同时只跑一个模型

# ============ 四、元数据库配置（MySQL 8，qed 库）============
QED_DB_HOST=127.0.0.1
QED_DB_PORT=3306
QED_DB_NAME=qed
QED_DB_USER=root
QED_DB_PASSWORD=
