# ============ 模型模式与密钥（2026-08-20 统一约定）============
# 三项目各自 .env 分置，各负责自身配置；本模板为 QED-Engine（根仓库）版本。
# 空值表示未配置，服务使用自身降级默认运行，不阻塞启动。

# 模型模式：api（默认，API key 调用）/ local（本地模型：文字 Qwen + 图像 MinerU）
QED_API_SELECT=api

# 统一供应商 key（QED_API_PROVIDER 选择厂商；逐厂商 key（QWEN/DEEPSEEK/GLM_API_KEY）已取消，API_KEY 唯一）
API_KEY=
# 厂商选择（api 模式）：qwen（默认）/ deepseek / glm（注册表预留，启用时验证真实可用性）
QED_API_PROVIDER=qwen

# qed-engine 模式读取（QED-Tracker / Axiom-Flow 的 QED_API_SELECT=qed-engine 时经此网关调用）
QED_LLM_GATEWAY_URL=http://127.0.0.1:8900

# ============ 本地模型与资源互斥（local 模式）============
# local 文字模型：Qwen（OpenAI 兼容；本机 qwen 7b 量化实测端口 5001）
QED_QWEN_URL=http://127.0.0.1:5001/v1

# local 图像模型：MinerU 容器（WSL，脚本编排见 scripts/image-model/）
QED_MINERU_URL=http://127.0.0.1:8002

# 资源互斥开关（默认开）：启动一方本地模型前先停另一方（4080 16GB 显存约束）
QED_RESOURCE_GUARD=true

# ============ 模型选择 ============
# 单线路策略：一次只启用一条模型线路（当前 qwen 三用途），暂不用备用线路。
# 主对话模型（QED-Engine 后端/解析文本模型）
QED_MODEL=qwen-plus

# OCR/视觉模型；映射：Axiom-Flow 读 AXIOM_VISION_MODEL
QED_OCR_MODEL=qwen-vl-plus

# 嵌入模型（向量化）
QED_EMBEDDING_MODEL=text-embedding-v4

# ============ 网络 ============
# 本地代理（Clash 默认混合端口）：污染/限流的 archive.org、openlibrary.org 走代理
QED_PROXY=http://127.0.0.1:7890

# ============ 服务地址（可选覆盖，默认即全局端口规划）============
# 不填则使用内置默认：配置中心 http://127.0.0.1:8900 / QED-Tracker 8901 /
# Axiom-Flow 8902。注意：不要填空值，空值会覆盖默认。
# QED_CONFIG_CENTER_URL=http://127.0.0.1:8900
# QED_TRACKER_URL=http://127.0.0.1:8901
# QED_AXIOM_URL=http://127.0.0.1:8902

# ============ 数据根（2026-08-23 ARCH-019）============
# 三项目统一数据根：raw|tmp|parsed/<domain>/<course>/ 布局见 docs/design/dataset-conventions.md
# 解析优先级：真实环境变量 > 自身 .env > 向上走查父目录 .env > 内置默认（<工作目录>/dataset/）
# 三项目各持 .env 配置相同绝对路径即共享同一目录树；留空则使用内置默认
QED_DATA_ROOT=D:\coding\QED-Engine\dataset

# ============ 统一数据库（MySQL 8，qed 库）============
# 三个项目共用同一 MySQL 8 实例与 qed 库：QED-Tracker 用 qt_* 表、Axiom-Flow 用 af_* 表。
# 调用记录表 qed_llm_calls 由三项目共写（LLM 网关与模型管理设计，见 docs/design/）。
# QED_DB_* 各项目 .env 各持一份；Axiom-Flow 旧变量 AXIOM_MYSQL_* 保留为别名（默认库名改为 qed）。
# 密码为空表示未配置，数据库相关能力降级，不阻塞服务启动。
QED_DB_HOST=127.0.0.1
QED_DB_PORT=3306
QED_DB_NAME=qed
QED_DB_USER=root
QED_DB_PASSWORD=