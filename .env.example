# ============ API Keys（按供应商集中管理）============
# 根 .env 是三个项目密钥的唯一事实源，不入版本控制。
# 空值表示未配置，子项目使用自身降级默认运行，不阻塞启动。

# deepseek：推理/文本模型（QED-Engine 后端、解析文本模型，预留）
DEEPSEEK_API_KEY=

# qwen：阿里百炼，OCR/视觉模型
# 映射：Axiom-Flow 读 AXIOM_API_KEY，QED-Tracker 读 DASHSCOPE_API_KEY
QWEN_API_KEY=

# glm：智谱（备选/未来模型，预留）
GLM_API_KEY=

# ============ 模型选择 ============
# 主对话模型（当前生效档，QED-Engine 后端/解析文本模型）
# 切换策略：测试期用 qwen，正式操作切 GLM（QED_MODEL=glm-5.2）
QED_MODEL=qwen-plus

# OCR/视觉模型（当前生效档）；映射：Axiom-Flow 读 AXIOM_VISION_MODEL
QED_OCR_MODEL=qwen-vl-plus

# 嵌入模型（向量化）
QED_EMBEDDING_MODEL=text-embedding-v4

# GLM 推荐模型（切换档，GLM-5.2 旗舰，1M 上下文）
GLM_MODEL=glm-5.2

# GLM 专用文档 OCR（布局+文本提取，支持图片/PDF；走文档解析接口，Axiom-Flow 对接轮适配）
GLM_OCR_MODEL=glm-ocr

# deepseek 推荐模型（占位：deepseek-chat 已退役，key 配置后生效）
DEEPSEEK_MODEL=deepseek-v4-flash
