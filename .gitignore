# 嵌入的独立仓库（各自含 .git，不在本仓库维护）
/Axiom-Flow/
/QED-Tracker/

# 数据集（原始文档与解析产物，仅保留目录骨架）
/dataset/*
!/dataset/.gitkeep
!/dataset/axiom-flow/
!/dataset/axiom-flow/.gitkeep
/dataset/qed-tracker/*
!/dataset/qed-tracker/.gitkeep

# 本地模型文件（MinerU 权重 / Qwen GGUF），不入库
/model

# IDE / 编辑器
/.idea/
.vscode/
# Qoder 工作区：技能正本（L2 四件套＋本仓 L3）与权限边界入库，其余（scratch/、缓存）继续忽略。
# 目录模式必须写成内容模式，否则被排除目录的子项无法重新纳入（2026-10-20 三仓统一，REQ-124 形态②）。
.qoder/*
!.qoder/skills/
!.qoder/settings.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
backend/*.egg-info/

# Node
node_modules/
dist/
build/

# 日志与运行产物
/logs/
*.log
*.pid

# 临时文件
/tmp/

# 数据库运维产物（清理归档，不入库；备份位已退役，快照唯一落点＝dataset/backups/，ADR 0019）
/backend/database/*.sql.backup

# 环境变量与密钥
.env
.env.*
!.env.example
# web-ui 生产构建配置（非密钥，入库保证构建可复现）：VITE_API_BASE=8900
!web-ui/.env.production

# 系统
Thumbs.db
.DS_Store

# 仓库内备份位已退役（ADR 0019 第 4 条）：不再忽略 /backups/，野生备份目录应在 git status 可见
