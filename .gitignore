# 嵌入的独立仓库（各自含 .git，不在本仓库维护）
/Axiom-Flow/
/QED-Tracker/

# 数据集（原始文档与解析产物，仅保留目录骨架）
/dataset/*
!/dataset/.gitkeep
!/dataset/axiom-flow/
!/dataset/axiom-flow/.gitkeep
/dataset/qed-tracker/*
!/dataset/qed-tracker/.gitkeep

# IDE / 编辑器
/.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
backend/*.egg-info/

# Node
node_modules/
dist/
build/

# 日志与运行产物
/logs/
*.log
*.pid

# 临时文件
/tmp/

# 数据库运维产物（备份与清理归档，不入库）
/backend/database/backups/*
!/backend/database/backups/.gitkeep
/backend/database/*.sql.backup

# 环境变量与密钥
.env
.env.*
!.env.example
# web-ui 生产构建配置（非密钥，入库保证构建可复现）：VITE_API_BASE=8900
!web-ui/.env.production

# 系统
Thumbs.db
.DS_Store

# ARCH-019 data-operation backups (D-class, not tracked)
/backups/
